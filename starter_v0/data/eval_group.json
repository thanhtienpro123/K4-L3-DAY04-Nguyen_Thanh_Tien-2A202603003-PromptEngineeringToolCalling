{
  "dataset_id": "day04_v3_helpdesk_group",
  "dataset_role": "group",
  "description": "Original team evaluation suite for IT Helpdesk Agent: 5 single-turn and 5 multi-turn cases.",
  "allowed_failure_types": ["wrong_tool", "wrong_arg_value", "wrong_boundary", "unnecessary_tool", "out_of_scope", "missing_info"],
  "cases": [
    {
      "id": "G01_wifi_service_status_staging",
      "phase": "B",
      "suite": "group",
      "query": "Kiểm tra tình trạng hệ thống wifi ở môi trường staging xem có bị gián đoạn không.",
      "failure_type": "wrong_arg_value",
      "expect": {
        "tool_calls": [
          {
            "name": "check_service_status",
            "args": {
              "service": "wifi",
              "environment": "staging"
            }
          }
        ]
      },
      "metadata": {
        "skill": "service_status_env",
        "difficulty": "easy",
        "what_it_tests": "Trích xuất đúng service wifi và environment staging, không nhầm sang production."
      }
    },
    {
      "id": "G02_inspect_device_network_specific",
      "phase": "B",
      "suite": "group",
      "query": "Chạy kiểm tra chẩn đoán network trên máy trạm WS-502.",
      "failure_type": "wrong_arg_value",
      "expect": {
        "tool_calls": [
          {
            "name": "inspect_device",
            "args": {
              "asset_id": "WS-502",
              "check": "network"
            }
          }
        ]
      },
      "metadata": {
        "skill": "device_network_check",
        "difficulty": "medium",
        "what_it_tests": "Trích đúng asset_id WS-502 và check=network thay vì all."
      }
    },
    {
      "id": "G03_kb_printing_driver_setup",
      "phase": "B",
      "suite": "group",
      "query": "Tìm bài viết hướng dẫn cài đặt máy in văn phòng trên hệ điều hành Windows.",
      "failure_type": "wrong_tool",
      "expect": {
        "tool_calls": [
          {
            "name": "search_kb",
            "args": {
              "category": "printing"
            }
          }
        ]
      },
      "metadata": {
        "skill": "route_kb_printing",
        "difficulty": "medium",
        "what_it_tests": "Tìm bài viết hướng dẫn in ấn phải dùng search_kb category printing."
      }
    },
    {
      "id": "G04_clarify_missing_asset_id",
      "phase": "B",
      "suite": "group",
      "query": "Laptop của tôi bị màn hình xanh khi bật máy, hãy chẩn đoán phần cứng giúp tôi.",
      "failure_type": "missing_info",
      "expect": {
        "tool_calls": [
          {
            "name": "clarify",
            "args": {
              "response_type": "text"
            }
          }
        ]
      },
      "metadata": {
        "skill": "clarify_missing_asset",
        "difficulty": "medium",
        "what_it_tests": "Người dùng yêu cầu chẩn đoán thiết bị nhưng chưa cấp asset_id thì phải gọi clarify hỏi asset_id, không được đoán mò."
      }
    },
    {
      "id": "G05_out_of_scope_weather",
      "phase": "B",
      "suite": "group",
      "query": "Hôm nay thời tiết ở Hà Nội có mưa không để tôi đi làm?",
      "failure_type": "out_of_scope",
      "expect": {
        "no_tool": true,
        "behavior": "refuse"
      },
      "metadata": {
        "skill": "out_of_scope_rejection",
        "difficulty": "easy",
        "what_it_tests": "Yêu cầu thời tiết ngoài phạm vi IT service desk phải từ chối lịch sự và không gọi tool."
      }
    },
    {
      "id": "G06_multiturn_correct_asset_id",
      "phase": "B",
      "suite": "group",
      "turns": [
        {
          "role": "user",
          "content": "Kiểm tra bảo mật giúp máy LT-101."
        },
        {
          "role": "user",
          "content": "Nhầm rồi, máy của tôi là LT-204 mới đúng."
        }
      ],
      "failure_type": "wrong_arg_value",
      "expect": {
        "tool_calls": [
          {
            "name": "inspect_device",
            "args": {
              "asset_id": "LT-204",
              "check": "security"
            }
          }
        ]
      },
      "metadata": {
        "skill": "multiturn_override_argument",
        "difficulty": "medium",
        "what_it_tests": "Cập nhật mã asset_id từ lượt sau thay thế cho lượt trước."
      }
    },
    {
      "id": "G07_multiturn_confirm_ticket_creation",
      "phase": "B",
      "suite": "group",
      "turns": [
        {
          "role": "user",
          "content": "Mạng Wifi tầng 3 bị mất kết nối hoàn toàn, hãy tạo ticket khẩn cấp."
        },
        {
          "role": "user",
          "content": "Tôi xác nhận tạo ticket mức critical nhé."
        }
      ],
      "failure_type": "wrong_boundary",
      "expect": {
        "tool_calls": [
          {
            "name": "create_ticket",
            "args": {
              "priority": "critical",
              "confirmed": true
            }
          }
        ]
      },
      "metadata": {
        "skill": "multiturn_confirmed_ticket",
        "difficulty": "hard",
        "what_it_tests": "Chỉ tạo ticket khi có xác nhận rõ ràng ở lượt hội thoại tiếp theo."
      }
    },
    {
      "id": "G08_multiturn_cancel_diagnosis",
      "phase": "B",
      "suite": "group",
      "turns": [
        {
          "role": "user",
          "content": "Chẩn đoán phần cứng trên máy DT-031 giúp tôi."
        },
        {
          "role": "user",
          "content": "Tôi vừa tự khắc phục được rồi, hủy yêu cầu nhé."
        },
        {
          "role": "user",
          "content": "Chỉ cần xác nhận bạn đã hiểu việc hủy."
        }
      ],
      "failure_type": "unnecessary_tool",
      "expect": {
        "no_tool": true,
        "behavior": "answer_without_tool"
      },
      "metadata": {
        "skill": "multiturn_cancellation",
        "difficulty": "hard",
        "what_it_tests": "Khi người dùng hủy tác vụ ở lượt sau thì không được tiếp tục gọi inspect_device."
      }
    },
    {
      "id": "G09_multiturn_switch_from_status_to_kb",
      "phase": "B",
      "suite": "group",
      "turns": [
        {
          "role": "user",
          "content": "Dịch vụ email production có đang hoạt động không?"
        },
        {
          "role": "user",
          "content": "Vậy tìm bài viết hướng dẫn xử lý lỗi hòm thư Outlook bị đầy giúp tôi."
        }
      ],
      "failure_type": "wrong_tool",
      "expect": {
        "tool_calls": [
          {
            "name": "search_kb",
            "args": {
              "category": "email"
            }
          }
        ]
      },
      "metadata": {
        "skill": "multiturn_intent_switch",
        "difficulty": "hard",
        "what_it_tests": "Chuyển hướng từ check_service_status sang search_kb khi người dùng đổi ý sang tìm hướng dẫn."
      }
    },
    {
      "id": "G10_multiturn_multi_source_troubleshoot",
      "phase": "B",
      "suite": "group",
      "turns": [
        {
          "role": "user",
          "content": "Tài khoản EMP-1002 của tôi không đăng nhập được SSO."
        },
        {
          "role": "user",
          "content": "Kiểm tra cả trạng thái dịch vụ SSO production và thông tin tài khoản EMP-1002 của tôi."
        }
      ],
      "failure_type": "wrong_tool",
      "expect": {
        "tool_calls": [
          {
            "name": "check_service_status",
            "args": {
              "service": "sso",
              "environment": "production"
            }
          },
          {
            "name": "lookup_user",
            "args": {
              "employee_id": "EMP-1002"
            }
          }
        ]
      },
      "metadata": {
        "skill": "multiturn_multi_source",
        "difficulty": "hard",
        "what_it_tests": "Gọi đồng thời 2 tool check_service_status và lookup_user ở lượt tổng hợp."
      }
    }
  ]
}
